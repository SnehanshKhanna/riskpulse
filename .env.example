# Environment Variables Example
# Copy this file to .env and set your local values.

# Database
DATABASE_URL=sqlite:///./riskpulse.db

# Live Polling Config
# To enable Live Polling with NewsAPI (Fallback adapter), provide an API key.
# If omitted, RiskPulse will automatically use the open WSJ/SEC RSS feeds for Live mode.
NEWSAPI_KEY=your_newsapi_key_here

# App Mode
# Options: REPLAY (default), LIVE
DEFAULT_APP_MODE=REPLAY
